# Application
APP_ENV=development
LOG_LEVEL=info

# Crawl behavior
CRAWL_TIMEOUT=30
CRAWL_RETRY_COUNT=3
CRAWL_CONCURRENCY=4
CRAWL_USER_AGENT=image-crawler-system/0.1

# Local paths
DATA_DIR=./data
DOWNLOAD_DIR=./data/downloads

# Distributed Worker security
REQUIRE_WORKER_AUTH=true
ALLOW_LOCAL_CRAWL_TARGETS=false
# Required management API bearer credential. Generate locally; never commit a real value.
ADMIN_API_TOKEN=
WORKER_REGISTRATION_TOKEN=
BIND_HOST=127.0.0.1
PORT=3100
# Set a local database URL in server/.env, not in version control.
DATABASE_URL=
